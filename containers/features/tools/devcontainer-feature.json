{
  "id": "tools",
  "version": "1.0.0",
  "name": "Tools",
  "description": "A minimal environment for doing useful work.",
  "containerEnv": {
    "EDITOR": "vim"
  },
  "customizations": {
    "bottle": {
      "context": "`rg`, `fd`, `jq`, `curl`, `vim`, `less`, `unzip`, `tmux` and `shpool` are installed.",
      "apt": {
        "packages": [
          "ca-certificates",
          "curl",
          "fd-find",
          "jq",
          "less",
          "openssh-client",
          "procps",
          "ripgrep",
          "tmux",
          "unzip",
          "vim",
          "xz-utils"
        ]
      }
    }
  }
}
