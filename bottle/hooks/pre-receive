#!/bin/sh
# Bottle's one rule for pushes from a bottle to the host repo (see bottle/host.py).
# Runs on the host, never in the bottle: `git receive-pack`, serving the push in
# the host repo, runs it after the pushed objects arrive and before any ref
# moves. A non-zero exit refuses the whole push. The bottle can't skip it.
#
# What confines a push is GIT_NAMESPACE, not this hook: receive-pack reads and
# writes only refs/namespaces/<it>/, so the host's own refs are neither
# advertised to the bottle nor reachable by it, and git's ordinary rules
# (fast-forward unless forced, receive.denyDeletes) apply within the namespace.
# All that's left to check is that a namespace arrived at all.
if [ -z "${GIT_NAMESPACE:-}" ]; then
  echo "bottle: this push has no namespace; refusing it" >&2
  exit 1
fi
