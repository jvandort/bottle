#!/bin/sh
# Bottle's rules for pushes from a bottle to the host repo (see bottle/host.py).
# Runs on the host, never in the bottle: `git receive-pack`, serving the push in
# the host repo, runs it after the pushed objects arrive and before any ref
# moves. A non-zero exit refuses the whole push. The bottle can't skip it.
# A bottle may create agent/* branches and move them forward: nothing else,
# and never a force-push or a delete.
status=0
while read -r old new ref; do
  name=${ref#refs/heads/}
  case "$ref" in
    refs/heads/agent/*) ;;
    *) echo "bottle: pushes may only create or update agent/* branches, not $name" >&2; status=1; continue ;;
  esac
  case "$new" in
    *[!0]*) ;;
    *) echo "bottle: deleting $name isn't allowed" >&2; status=1; continue ;;
  esac
  case "$old" in
    *[!0]*) git merge-base --is-ancestor "$old" "$new" \
              || { echo "bottle: $name can only move forward (no force-pushes)" >&2; status=1; } ;;
  esac
done
exit $status
