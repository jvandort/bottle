#!/bin/sh
# Mirror what a bottle pushed to a branch the host can see.
#
# A bottle's refs live in its git namespace, refs/namespaces/bottle-<name>/,
# which `git branch` doesn't list and IDEs don't show, so work that arrives is
# invisible until someone goes looking for it. Copy each pushed ref to a branch
# under bottle-<name>/ as well. Temporary: the namespace is the real location,
# and how a bottle's work should surface on the host is still open.
[ -n "${GIT_NAMESPACE:-}" ] || exit 0
mirror=$GIT_NAMESPACE
unset GIT_NAMESPACE  # the mirror is an ordinary ref, not a namespaced one
while read -r _old new ref; do
  case "$ref" in refs/heads/*) ;; *) continue ;; esac
  git update-ref "refs/heads/$mirror/${ref#refs/heads/}" "$new" || exit 1
done
