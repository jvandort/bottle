#!/bin/sh
# After a push from a bottle, on the host: bring the host's checked-out
# branches up to what it pushed, where that's safe, and tell the bottle (see
# follow.py). bottled names its own Python; without it, nothing follows.
[ -n "${BOTTLE_PYTHON:-}" ] || exit 0
exec "$BOTTLE_PYTHON" "$(dirname "$0")/follow.py"
