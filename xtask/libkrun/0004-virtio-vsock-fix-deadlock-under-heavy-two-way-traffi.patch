From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Morten=20Kr=C3=A5kvik?= <morten@krakvik.io>
Date: Sun, 1 Nov 2026 11:01:10 +0100
Subject: [PATCH 4/5] virtio/vsock: fix deadlock under heavy two-way traffic
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

High-bandwidth bidirectional transfers over a unix-proxy connection
deadlock: both ends wait for credit and nothing moves again.

Host-to-guest data uses up the guest's RX descriptors, so push_packet()
parks control packets in rxq. drain_rxq() puts a packet it cannot deliver
back at the tail, so with two credit updates parked their order flips on
every retry and the older one can reach the guest last. Each update
carries an absolute fwd_cnt, and the guest keeps only the last one it
sees, so its view of our buffer moves backwards.

Linux caps its TX credit at its own buf_alloc (256 KiB by default), not
our 8 MiB, so falling back by two updates leaves it with no credit at all.
It blocks in send() with nothing unsent. We only send another update
after forwarding peer_buf_alloc / 2 more bytes, which the blocked guest
never sends, and no host-to-guest data is left to carry a fresh fwd_cnt
in its header.

Keep control packets in the order they were made, and never let a queued
one deliver an older fwd_cnt than a later one:

- drain_rxq() puts an undeliverable packet back at the head;
- push_packet() queues behind packets already waiting in rxq instead of
  overtaking them;
- rxq folds a credit update into one already queued for the connection,
  and brings every queued credit update or request for it up to the
  newest fwd_cnt.

The guest's last fwd_cnt is then never more than peer_buf_alloc / 2
behind, so it keeps credit.

Reproduced by echoing 1 MiB messages through a guest-initiated
unix-proxy port with a 6.12.112 guest: it stalled every run, within 62
to 334 round trips. With this change, five runs of 4000 round trips
and 8 GiB of pipelined echo each completed. Throughput unchanged.

Assisted-by: Claude Code: claude-opus-5-5
Signed-off-by: Morten Kråkvik <morten@krakvik.io>
(cherry picked from commit 68fb579e33ff3da542b658687d15129a3dd37ca9)
---
 src/devices/src/virtio/vsock/muxer.rs        |  29 +--
 src/devices/src/virtio/vsock/muxer_rxq.rs    | 256 ++++++++++++++++++-
 src/devices/src/virtio/vsock/muxer_thread.rs |   2 +-
 3 files changed, 269 insertions(+), 18 deletions(-)

diff --git a/src/devices/src/virtio/vsock/muxer.rs b/src/devices/src/virtio/vsock/muxer.rs
index 81f24679..7b5d173b 100644
--- a/src/devices/src/virtio/vsock/muxer.rs
+++ b/src/devices/src/virtio/vsock/muxer.rs
@@ -82,6 +82,15 @@ pub fn push_packet(
     mem: &GuestMemoryMmap,
 ) {
     let mut queue = queue_mutex.lock().unwrap();
+    let mut rxq = rxq_mutex.lock().unwrap();
+    // Packets already waiting in rxq go first: overtaking them reorders credit updates, and the
+    // guest keeps only the last fwd_cnt it receives.
+    if !rxq.is_empty() {
+        if !rxq.push(rx) {
+            error!("rxq full, dropping pkt");
+        }
+        return;
+    }
     if let Some(head) = queue.pop(mem) {
         if let Ok(mut pkt) = VsockPacket::from_rx_virtq_head(&head) {
             rx_to_pkt(cid, rx, &mut pkt);
@@ -91,8 +100,9 @@ pub fn push_packet(
         }
     } else {
         error!("couldn't push pkt to queue, adding it to rxq");
-        drop(queue);
-        rxq_mutex.lock().unwrap().push(rx);
+        if !rxq.push(rx) {
+            error!("rxq full, dropping pkt");
+        }
     }
 }
 
@@ -202,20 +212,7 @@ impl VsockMuxer {
             }
         };
 
-        let mut queue = queue_mutex.lock().unwrap();
-        if let Some(head) = queue.pop(mem) {
-            if let Ok(mut pkt) = VsockPacket::from_rx_virtq_head(&head) {
-                rx_to_pkt(self.cid, rx, &mut pkt);
-                if let Err(e) = queue.add_used(mem, head.index, pkt.hdr().len() as u32 + pkt.len())
-                {
-                    error!("failed to add used elements to the queue: {e:?}");
-                }
-            }
-        } else {
-            error!("couldn't push pkt to queue, adding it to rxq");
-            drop(queue);
-            self.rxq.lock().unwrap().push(rx);
-        }
+        push_packet(self.cid, rx, &self.rxq, queue_mutex, mem);
     }
 
     pub fn update_polling(&self, id: u64, fd: RawFd, evset: EventSet) {
diff --git a/src/devices/src/virtio/vsock/muxer_rxq.rs b/src/devices/src/virtio/vsock/muxer_rxq.rs
index ef1f7d75..bc33314b 100644
--- a/src/devices/src/virtio/vsock/muxer_rxq.rs
+++ b/src/devices/src/virtio/vsock/muxer_rxq.rs
@@ -54,7 +54,11 @@ impl MuxerRxQ {
     /// Returns:
     /// - `true` if the new item has been successfully queued; or
     /// - `false` if there was no room left in the queue.
-    pub fn push(&mut self, rx: MuxerRx) -> bool {
+    pub fn push(&mut self, mut rx: MuxerRx) -> bool {
+        if self.coalesce_credit(&mut rx) {
+            return true;
+        }
+
         // Pushing to a non-full, synchronized queue will always succeed.
         if self.is_synced() && !self.is_full() {
             self.q.push_back(rx);
@@ -64,6 +68,53 @@ impl MuxerRxQ {
         false
     }
 
+    /// Put back an item that was just popped but could not be delivered, keeping its place.
+    pub fn push_front(&mut self, rx: MuxerRx) {
+        self.q.push_front(rx);
+    }
+
+    /// The guest keeps only the last `fwd_cnt` it receives for a connection, so a queued
+    /// credit-carrying packet must never deliver an older one than a later packet carries:
+    /// that shrinks the guest's view of our buffer, and with nothing left to correct it the
+    /// connection stalls. Bring every such packet for the connection up to the newest
+    /// `fwd_cnt`, and fold a credit update into one already queued.
+    ///
+    /// Only packets queued since the connection's last reset or handshake packet count: before
+    /// that boundary the ports may belong to an earlier connection, whose `fwd_cnt` means
+    /// nothing to this one.
+    ///
+    /// Returns `true` if `rx` was folded into a queued credit update.
+    fn coalesce_credit(&mut self, rx: &mut MuxerRx) -> bool {
+        let Some((port, peer, new)) = credit_of(rx) else {
+            return false;
+        };
+        let start = self
+            .q
+            .iter()
+            .rposition(|queued| ports_of(queued) == (port, peer) && credit_of(queued).is_none())
+            .map_or(0, |boundary| boundary + 1);
+        let newest = self
+            .q
+            .range(start..)
+            .filter_map(credit_of)
+            .filter(|&(l, p, _)| (l, p) == (port, peer))
+            .map(|(_, _, f)| f)
+            .fold(new, |a, b| if is_after(b, a) { b } else { a });
+
+        set_fwd_cnt(rx, newest);
+        let mut folded = false;
+        for queued in self.q.range_mut(start..) {
+            if credit_of(queued).is_some_and(|(l, p, _)| (l, p) == (port, peer)) {
+                set_fwd_cnt(queued, newest);
+                folded |= matches!(
+                    (&*queued, &*rx),
+                    (MuxerRx::CreditUpdate { .. }, MuxerRx::CreditUpdate { .. })
+                );
+            }
+        }
+        folded
+    }
+
     /// Pop an RX item from the front of the queue.
     pub fn pop(&mut self) -> Option<MuxerRx> {
         self.q.pop_front()
@@ -90,6 +141,80 @@ impl MuxerRxQ {
     }
 }
 
+fn credit_of(rx: &MuxerRx) -> Option<(u32, u32, u32)> {
+    match *rx {
+        MuxerRx::CreditUpdate {
+            local_port,
+            peer_port,
+            fwd_cnt,
+        }
+        | MuxerRx::CreditRequest {
+            local_port,
+            peer_port,
+            fwd_cnt,
+        } => Some((local_port, peer_port, fwd_cnt)),
+        _ => None,
+    }
+}
+
+fn ports_of(rx: &MuxerRx) -> (u32, u32) {
+    match *rx {
+        MuxerRx::Reset {
+            local_port,
+            peer_port,
+        }
+        | MuxerRx::GetnameResponse {
+            local_port,
+            peer_port,
+            ..
+        }
+        | MuxerRx::ConnResponse {
+            local_port,
+            peer_port,
+            ..
+        }
+        | MuxerRx::OpRequest {
+            local_port,
+            peer_port,
+        }
+        | MuxerRx::OpResponse {
+            local_port,
+            peer_port,
+        }
+        | MuxerRx::CreditRequest {
+            local_port,
+            peer_port,
+            ..
+        }
+        | MuxerRx::CreditUpdate {
+            local_port,
+            peer_port,
+            ..
+        }
+        | MuxerRx::ListenResponse {
+            local_port,
+            peer_port,
+            ..
+        }
+        | MuxerRx::AcceptResponse {
+            local_port,
+            peer_port,
+            ..
+        } => (local_port, peer_port),
+    }
+}
+
+fn set_fwd_cnt(rx: &mut MuxerRx, value: u32) {
+    if let MuxerRx::CreditUpdate { fwd_cnt, .. } | MuxerRx::CreditRequest { fwd_cnt, .. } = rx {
+        *fwd_cnt = value;
+    }
+}
+
+/// Whether wrapping counter `a` is ahead of `b`.
+fn is_after(a: u32, b: u32) -> bool {
+    (a.wrapping_sub(b) as i32) > 0
+}
+
 pub fn rx_to_pkt(cid: u64, rx: MuxerRx, pkt: &mut VsockPacket) {
     match rx {
         MuxerRx::Reset {
@@ -225,3 +350,132 @@ pub fn rx_to_pkt(cid: u64, rx: MuxerRx, pkt: &mut VsockPacket) {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use std::iter;
+
+    use super::*;
+
+    fn update(fwd_cnt: u32) -> MuxerRx {
+        MuxerRx::CreditUpdate {
+            local_port: 5600,
+            peer_port: 1234,
+            fwd_cnt,
+        }
+    }
+
+    fn request(fwd_cnt: u32) -> MuxerRx {
+        MuxerRx::CreditRequest {
+            local_port: 5600,
+            peer_port: 1234,
+            fwd_cnt,
+        }
+    }
+
+    fn drain(q: &mut MuxerRxQ) -> Vec<Option<(u32, u32, u32)>> {
+        iter::from_fn(|| q.pop()).map(|rx| credit_of(&rx)).collect()
+    }
+
+    #[test]
+    fn credit_update_folds_into_queued_one() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(100)));
+        assert!(q.push(update(200)));
+        assert_eq!(drain(&mut q), vec![Some((5600, 1234, 200))]);
+    }
+
+    #[test]
+    fn older_credit_never_overtakes_newer() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(200)));
+        assert!(q.push(request(100)));
+        assert_eq!(
+            drain(&mut q),
+            vec![Some((5600, 1234, 200)), Some((5600, 1234, 200))]
+        );
+    }
+
+    #[test]
+    fn credit_request_is_brought_up_to_date() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(request(100)));
+        assert!(q.push(update(300)));
+        assert_eq!(
+            drain(&mut q),
+            vec![Some((5600, 1234, 300)), Some((5600, 1234, 300))]
+        );
+    }
+
+    #[test]
+    fn other_connections_are_left_alone() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(100)));
+        assert!(q.push(MuxerRx::CreditUpdate {
+            local_port: 5601,
+            peer_port: 1234,
+            fwd_cnt: 900,
+        }));
+        assert_eq!(
+            drain(&mut q),
+            vec![Some((5600, 1234, 100)), Some((5601, 1234, 900))]
+        );
+    }
+
+    #[test]
+    fn newest_wins_across_counter_wrap() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(u32::MAX - 10)));
+        assert!(q.push(update(5)));
+        assert_eq!(drain(&mut q), vec![Some((5600, 1234, 5))]);
+    }
+
+    #[test]
+    fn push_front_keeps_the_order() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(100)));
+        assert!(q.push(MuxerRx::Reset {
+            local_port: 5600,
+            peer_port: 1234,
+        }));
+        let first = q.pop().unwrap();
+        q.push_front(first);
+        assert_eq!(drain(&mut q), vec![Some((5600, 1234, 100)), None]);
+    }
+
+    #[test]
+    fn never_coalesces_across_a_reset() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(300_000_000)));
+        assert!(q.push(MuxerRx::Reset {
+            local_port: 5600,
+            peer_port: 1234,
+        }));
+        assert!(q.push(update(5)));
+        assert_eq!(
+            drain(&mut q),
+            vec![Some((5600, 1234, 300_000_000)), None, Some((5600, 1234, 5))]
+        );
+    }
+
+    #[test]
+    fn coalesces_only_within_the_current_connection() {
+        let mut q = MuxerRxQ::new();
+        assert!(q.push(update(300_000_000)));
+        assert!(q.push(MuxerRx::OpResponse {
+            local_port: 5600,
+            peer_port: 1234,
+        }));
+        assert!(q.push(request(10)));
+        assert!(q.push(update(20)));
+        assert_eq!(
+            drain(&mut q),
+            vec![
+                Some((5600, 1234, 300_000_000)),
+                None,
+                Some((5600, 1234, 20)),
+                Some((5600, 1234, 20)),
+            ]
+        );
+    }
+}
diff --git a/src/devices/src/virtio/vsock/muxer_thread.rs b/src/devices/src/virtio/vsock/muxer_thread.rs
index f8ea8ec6..392839a7 100644
