+++ b/src/devices/src/virtio/vsock/muxer_thread.rs
@@ -81,7 +81,7 @@ impl MuxerThread {
                     drained = true;
                 }
             } else {
-                rxq.push(rx);
+                rxq.push_front(rx);
                 break;
             }
         }
