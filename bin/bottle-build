#!/bin/sh
# Every distribution of bottle-cli this machine builds, each built if its sources have changed since
# it was: this machine's own (target/dist), and beside it each other one bottle-cli is built for
# (target/dist-TARGET), whether any runner needs it or not, which is where bottle-cli takes a
# runner's from. On a Mac, Linux's two; on Linux, the other architecture's. Whether they have is a
# hash of their contents and names, without starting cargo, against the one each distribution's last
# build left beside it (.sources); a build is one `cargo xtask dist` for every one that's changed,
# its progress on stderr, and leaves the hash once it's done.
#
#   bottle-build
set -eu
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
cd "$root"

# What bottle-cli is built from. A compiled sha256sum where there's one (Linux; recent macOS), else
# shasum. In a fixed order, whatever the locale.
if command -v sha256sum >/dev/null 2>&1; then sum=sha256sum; else sum="shasum -a 256"; fi
sources=$(find Cargo.toml Cargo.lock .cargo agent agent-client agent-proto cli disk xtask \
            -path '*/target' -prune -o -type f -print \
          | LC_ALL=C sort | tr '\n' '\0' | xargs -0 $sum | $sum | cut -d' ' -f1)
# This machine's own, and the others: on a Mac, Linux's two (built in a Linux VM); on Linux, the
# other architecture's.
case $(uname -s)/$(uname -m) in
  Darwin/arm64) own=aarch64-apple-darwin
    others="aarch64-unknown-linux-musl x86_64-unknown-linux-musl" ;;
  Linux/x86_64) own=x86_64-unknown-linux-musl; others=aarch64-unknown-linux-musl ;;
  Linux/aarch64) own=aarch64-unknown-linux-musl; others=x86_64-unknown-linux-musl ;;
  *) echo "bottle-build: bottle-cli isn't built for $(uname -s) on $(uname -m)" >&2; exit 1 ;;
esac
# Those whose sources have changed since they were built, all in one `cargo xtask dist`: Linux's by
# one cargo, which builds what they share once.
stale=""
for target in $own $others; do
  if [ "$target" = "$own" ]; then dist=target/dist; else dist=target/dist-$target; fi
  if [ ! -f "$dist/bottle-cli" ] || [ "$(cat "$dist/.sources" 2>/dev/null)" != "$sources" ]; then
    stale="$stale $target"
  fi
done
[ -n "$stale" ] || exit 0
# rustup's cargo, if it isn't on PATH.
cargo=$(command -v cargo || echo "$HOME/.cargo/bin/cargo")
# shellcheck disable=SC2086
"$cargo" xtask dist $(for target in $stale; do printf ' --target %s' "$target"; done) >&2
for target in $stale; do
  if [ "$target" = "$own" ]; then dist=target/dist; else dist=target/dist-$target; fi
  printf '%s' "$sources" > "$dist/.sources"
done
