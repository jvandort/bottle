#!/bin/sh
# bottle-cli's dev hook for a runner's distribution ($BOTTLE_DIST_BUILD): the one for TARGET (a Rust
# target triple), built from this checkout's sources if they've changed since it was.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cargo=$(command -v cargo || echo "$HOME/.cargo/bin/cargo")
cd "$root" && exec "$cargo" xtask dist --target "$1" --if-changed
