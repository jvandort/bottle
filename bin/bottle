#!/usr/bin/env python3
# The dev shim: bottle-cli, built first from this checkout's sources if they've changed since it was (see
# bottle/prereqs.py), then run with these arguments. Keep this file Python 3.9-compatible so macOS's
# /usr/bin/python3 gets a clear error.
import os
import sys

if sys.version_info < (3, 11):
    sys.exit(f"bottle requires Python 3.11+ (found {sys.version.split()[0]} at {sys.executable})")

from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from bottle import prereqs

try:
    prereqs.ensure_cli()
except prereqs.PrereqError as e:
    sys.exit(f"bottle: error: {e}")
os.execv(prereqs.binary(), [prereqs.binary(), *sys.argv[1:]])
