#!/bin/sh
# The dev shim: bottle-cli from this checkout, built first if its sources have changed since it was
# (bin/bottle-build, with every runner's), then run with these arguments; or the one $BOTTLE_CLI
# names, as it is.
set -eu
if [ -n "${BOTTLE_CLI:-}" ]; then
  exec "$BOTTLE_CLI" "$@"
fi
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
"$root/bin/bottle-build"
exec "$root/target/dist/bottle-cli" "$@"
