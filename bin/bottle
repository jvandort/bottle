#!/bin/sh
# The dev shim: bottle-cli from this checkout, built first if its sources have changed since it was
# (bin/bottle-build), then run with these arguments; or the one $BOTTLE_CLI names, as it is.
set -eu
if [ -n "${BOTTLE_CLI:-}" ]; then
  exec "$BOTTLE_CLI" "$@"
fi
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
"$root/bin/bottle-build"
# A runner's, built the same way, as bottle-cli's about to copy it there.
export BOTTLE_DIST_BUILD="${BOTTLE_DIST_BUILD:-$root/bin/bottle-build}"
exec "$root/target/dist/bottle-cli" "$@"
