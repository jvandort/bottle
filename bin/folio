#!/bin/sh
# The dev shim: folio from this checkout, with bottle-cli from it, each built first if its sources
# have changed since it was (bin/folio-build; bin/bottle-build, with every runner's), unless
# $FOLIO_CLI or $BOTTLE_CLI names one.
set -eu
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
if [ -z "${BOTTLE_CLI:-}" ]; then
  "$root/bin/bottle-build"
  export BOTTLE_CLI="$root/target/dist/bottle-cli"
fi
if [ -n "${FOLIO_CLI:-}" ]; then
  exec "$FOLIO_CLI" "$@"
fi
"$root/bin/folio-build"
exec "$root/target/release/folio" "$@"
