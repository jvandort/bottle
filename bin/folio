#!/bin/sh
# The dev shim: folio from this checkout, with bottle-cli from it, built first if its sources have
# changed since it was (bin/bottle-build), unless $BOTTLE_CLI names one; and how bottle-cli gets a
# runner's built ($BOTTLE_DIST_BUILD). folio itself builds nothing. $FOLIO_PYTHON, if it's set, is
# the Python it runs on.
set -eu
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
if [ -z "${BOTTLE_CLI:-}" ]; then
  "$root/bin/bottle-build"
  export BOTTLE_CLI="$root/target/dist/bottle-cli"
  export BOTTLE_DIST_BUILD="${BOTTLE_DIST_BUILD:-$root/bin/bottle-build}"
fi
export PYTHONPATH="$root/folio${PYTHONPATH:+:$PYTHONPATH}"
exec "${FOLIO_PYTHON:-python3}" -m folio "$@"
