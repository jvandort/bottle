#!/bin/sh
# The dev shim: folio from this checkout, with bottle-cli and folio-cli from it, each built first if
# its sources have changed since it was (bin/bottle-build, with every runner's; bin/folio-build),
# unless $BOTTLE_CLI or $FOLIO_CLI names one. folio's Python builds nothing. $FOLIO_PYTHON, if it's
# set, is the Python it runs on.
set -eu
# The checkout this script is in, through any symlinks to it (one on PATH, say).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
if [ -z "${BOTTLE_CLI:-}" ]; then
  "$root/bin/bottle-build"
  export BOTTLE_CLI="$root/target/dist/bottle-cli"
fi
if [ -z "${FOLIO_CLI:-}" ]; then
  "$root/bin/folio-build"
  export FOLIO_CLI="$root/target/release/folio-cli"
fi
export PYTHONPATH="$root/folio${PYTHONPATH:+:$PYTHONPATH}"
exec "${FOLIO_PYTHON:-python3}" -m folio "$@"
